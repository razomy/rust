Program = { SOI ~ statements ~ EOI }

// --- 1. ПРОБЕЛЫ И КОММЕНТАРИИ ---
WHITESPACE = _{ " " | "\t" | "\r" }
WS_NL      = _{ WHITESPACE | NEWLINE }
COMMENT    = _{ line_comment | block_comment }

line_comment  = @{ ("//" | ("#" ~ !("\r"? ~ "\n"))) ~ (!NEWLINE ~ ANY)* }
block_comment = @{
    "#" ~ PUSH(ASCII_DIGIT*) ~ &("\r"? ~ "\n")
  ~ (!(PEEK ~ "#" ~ (WHITESPACE | NEWLINE | EOI)) ~ ANY)*
  ~ POP ~ "#"
}
// --- 2. СТРУКТУРА И МНОГОСТРОЧНЫЕ ПАЙПЛАЙНЫ ---
PIPE_OP_AHEAD = @{
    ".~" | ".>" | ".&" | "./" | ".?" | ".!" | ".|" | ".="
  | "+=" | "-=" | "*=" | "/=" | "&="
  | ".+" | ".-" | ".*" | ".>=" | ".<=" | ".==" | ".!="
  | (("." | "&" | "|") ~ WS_NL)
}

pipe_nl    = _{ (NEWLINE ~ (WHITESPACE | COMMENT)*)+ ~ &PIPE_OP_AHEAD }
SEP        = _{ "," | (!pipe_nl ~ NEWLINE) }
statements = _{ ("," | NEWLINE)* ~ (sentence ~ (SEP+ ~ sentence)*)? ~ ("," | NEWLINE)* }

sentence = { (callable_op | token) ~ (pipe_nl? ~ token)* }

// --- 3. ТОКЕНЫ И ГРУППЫ ---
token = _{
    group
  | raw_string_lit
  | tagged_string_lit
  | string_lit
  | symbol_lit
  | hex_byte_lit
  | number_lit
  | operator
  | path
}

group         = _{ brace_group | bracket_group | paren_group }
brace_group   = { "{" ~ statements ~ "}" }
bracket_group = { "[" ~ statements ~ "]" }
paren_group   = { "(" ~ statements ~ ")" }

// --- 4. СТРОКИ И СИМВОЛЫ ---
raw_string_lit = @{
    "r" ~ PUSH(ASCII_DIGIT*) ~ "\""
  ~ (!("\"" ~ PEEK) ~ ANY)*
  ~ "\"" ~ POP
}

type_ident        = @{ ASCII_ALPHA_UPPER ~ (ASCII_ALPHANUMERIC | "_")* }
tagged_string_lit = ${ type_ident ~ (raw_string_lit | string_lit) }

string_lit = @{ "\"" ~ ("\\" ~ ANY | !"\"" ~ ANY)* ~ "\"" }
symbol_lit = @{ "'"  ~ ("\\" ~ ANY | !"'"  ~ ANY)* ~ "'" }

// --- 5. ЧИСЛА ---
hex_byte_lit = @{ "0x" ~ ASCII_HEX_DIGIT+ ~ !(ASCII_ALPHANUMERIC | "_") }
number_lit = @{
    "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ (^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+)?
  ~ !(ident | ("." ~ !(ident | ".")))
}

// --- 6. ОПЕРАТОРЫ (4 ORTHOGONAL SYMMETRIC LAYERS COMBINED) ---
overload_op = _{ "==" | "!=" | ">=" | "<=" | "**" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" | ">" | "<" }

callable_op = @{ overload_op ~ &(WHITESPACE* ~ "(") }

unary_op = _{
    ("!" ~ !("=" | WS_NL))
  | ("&" ~ !("&" | "=" | WS_NL))
  | ("-" ~ !(ASCII_DIGIT | "=" | WS_NL))
  | (".." ~ !WS_NL)
}

// Combined Layer 2 (Relative `.op`), Layer 3 (Spaced Pipes `.op`), Layer 4 (Rebind `op=`), and Layer 1 (Pure Math/Logic/Algebra)
dot_op    = _{ "." ~ ("==" | "!=" | ">=" | "<=" | "**" | "~" | "&" | "/" | "?" | "!" | "|" | "=" | "+" | "-" | "*" | "%" | ">" | "<")? }
rebind_op = _{ ("+" | "-" | "*" | "/" | "&") ~ "=" }
pure_op   = _{ "&&" | "||" | overload_op | "&" | "|" }

spaced_op = _{ (dot_op | rebind_op | pure_op) ~ &(WS_NL | EOI) }

operator = @{
    unary_op
  | ".."
  | spaced_op
}

// --- 7. ПУТИ И ИДЕНТИФИКАТОРЫ ---
PATH_END  = _{ &(WS_NL | "," | "(" | ")" | "[" | "]" | "{" | "}" | ".." | EOI) }
path      = @{ ("." ~ (ident | index_seg) ~ ("." ~ (ident | index_seg))* | ident ~ ("." ~ (ident | index_seg))* | ".") ~ PATH_END }
ident     = _{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
index_seg = _{ "-"? ~ ASCII_DIGIT+ }