// =============================================================================
// RAZOMY LANGUAGE V4.7 — COMPLETE PRODUCTION PEST GRAMMAR
// =============================================================================

Program = { SOI ~ statements ~ EOI }

// --- ПРОБЕЛЫ И КОММЕНТАРИИ ---
WHITESPACE = _{ " " | "\t" | "\r" }

COMMENT = _{ line_comment | block_comment }
line_comment  = @{ "//" ~ (!NEWLINE ~ ANY)* }
// '#' открывает блочный комментарий ТОЛЬКО если за ним идет пробел или перевод строки.
// Внутри разрешены закавыченные '#' ("'#'" и "\"#\"").
block_comment = @{ "#" ~ &(" " | "\t" | "\r" | NEWLINE) ~ ( "'#'" | "\"#\"" | (!"#" ~ ANY) )* ~ "#" }

// --- РАЗДЕЛИТЕЛИ И МНОГОСТРОЧНЫЕ ПАЙПЛАЙНЫ ---
// ВАЖНО: `@` (atomic) гарантирует, что Pest не съест пробелы после "." неявным WHITESPACE*
PIPE_OP_AHEAD = @{
    ".>" | ".&" | ".?" | ".|"
  | ("." ~ (" " | "\t" | "\r" | NEWLINE))
}

// Перевод строки продолжает текущее предложение, если первое, что идет после
// любых пустых строк, отступов и комментариев — это оператор пайплайна.
pipe_nl = _{ (NEWLINE ~ (WHITESPACE | COMMENT)*)+ ~ &PIPE_OP_AHEAD }

// Разделитель предложений срабатывает только тогда, когда это НЕ продолжение пайплайна
SEP = _{ "," | (!pipe_nl ~ NEWLINE) }

statements = _{ ( "," | NEWLINE )* ~ (sentence ~ (SEP+ ~ sentence)*)? ~ ( "," | NEWLINE )* }

// ВАЖНО: callable_op (`+(Other Vec2)`) разрешен ТОЛЬКО в начале предложения (head_token)!
// В середине предложения бинарный оператор перед `(` обязан иметь пробел: `A + (B)`.
sentence   = { head_token ~ (pipe_nl? ~ tail_token)* }

// =============================================================================
// ТОКЕНЫ (СТРОГИЙ ПОРЯДОК ДЛЯ O(1) ЛЕКСИНГА)
// =============================================================================
head_token = _{
    group
  | range_expr
  | string_lit
  | symbol_lit
  | rich_literal
  | number_lit
  | callable_op
  | operator
  | callable_path
  | path
}

tail_token = _{
    group
  | range_expr
  | string_lit
  | symbol_lit
  | rich_literal
  | number_lit
  | operator
  | callable_path
  | path
}

// 1. Три гомоиконные скобки: {} (Form), [] (Stream), () (Tuple)
group = _{ brace_group | bracket_group | paren_group }
brace_group   = { "{" ~ statements ~ "}" }
bracket_group = { "[" ~ statements ~ "]" }
paren_group   = { "(" ~ statements ~ ")" }

// 2. Строки "..." (с экранированием) и Символы '...'
string_lit = @{ "\"" ~ ( "\\\"" | "\\\\" | "\\{" | "\\}" | (!"\"" ~ ANY) )* ~ "\"" }
symbol_lit = @{ "'" ~ ( "\\'" | "\\\\" | (!"'" ~ ANY) )* ~ "'" }

// 3. Диапазоны (Ranges): 1..10, 1..Limit, 1..Config.Max, "0".."9", "a".."z"
range_atom = _{ string_lit | symbol_lit | number_lit | path_core }
range_expr = ${ range_atom ~ ".." ~ range_atom }

// 4. Богатые самотипизированные литералы (Rich Human Literals — без пробелов)
// ВАЖНО: hex_byte_lit стоит ДО coord_lit, чтобы 0x00 не парсился как координата!
rich_literal = _{
    url_lit
  | file_lit
  | email_lit
  | money_lit
  | hex_byte_lit
  | date_lit
  | time_lit
  | ip_lit
  | version_lit
  | coord_lit
  | duration_lit
  | percent_lit
  | color_lit
}

// Поддержка интерполяции {Expr} внутри некавыченных URL и File литералов
interp_chunk = _{ "{" ~ (!("}" | " " | "\t" | "\r" | NEWLINE) ~ ANY)* ~ "}" }
url_char     = _{ interp_chunk | (!(" " | "\t" | "\r" | NEWLINE | "," | ")" | "]" | "{" | "}") ~ ANY) }

url_lit      = @{ ("https://" | "http://") ~ url_char+ }
file_lit     = @{ "%" ~ url_char+ }
email_lit    = @{ (ASCII_ALPHANUMERIC | "_" | "." | "-" | "+")+ ~ "@" ~ (ASCII_ALPHANUMERIC | "-")+ ~ ("." ~ (ASCII_ALPHANUMERIC | "-")+)+ }
money_lit    = @{ ASCII_ALPHA_UPPER{0, 3} ~ "$" ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
hex_byte_lit = @{ "0x" ~ ASCII_HEX_DIGIT+ ~ !(ASCII_ALPHANUMERIC | "_") }
date_lit     = @{ ASCII_DIGIT{4} ~ "-" ~ ASCII_DIGIT{2} ~ "-" ~ ASCII_DIGIT{2} }
time_lit     = @{ ASCII_DIGIT{2} ~ ":" ~ ASCII_DIGIT{2} ~ (":" ~ ASCII_DIGIT{2})? }
ip_lit       = @{ ASCII_DIGIT{1,3} ~ ("." ~ ASCII_DIGIT{1,3}){3} ~ (":" ~ ASCII_DIGIT+)? }
version_lit  = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ ("-" ~ (ASCII_ALPHANUMERIC | "." | "-")+)? }
coord_lit    = @{ !"0x" ~ ASCII_DIGIT+ ~ ("x" ~ ASCII_DIGIT+)+ ~ !(ASCII_ALPHA | "_") }
duration_lit = @{ (ASCII_DIGIT+ ~ ("ms" | "s" | "m" | "h" | "d"))+ ~ !(ASCII_ALPHA | "_") }
percent_lit  = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ "%" }
color_lit    = @{ "#" ~ ASCII_HEX_DIGIT{3, 8} ~ !(ASCII_ALPHANUMERIC | "_") }

// 5. Числа (Int и Float)
// ВАЖНО: ("." ~ !".") запрещает одиночную точку после числа, но разрешает диапазон `..` (например, `1..100`)
number_lit = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ !(ASCII_ALPHA | "_" | ("." ~ !".")) }

// 6. Операторы:
// - `callable_op`: перегрузка оператора `+(Other Vec2)`, `<(Other) Bool` (слитно с `(`, только в начале sentence)
// - `operator`: бинарные операторы (отделяются пробелом) и унарный `!` (примыкает плотно)
overload_op = _{ "==" | "!=" | ">=" | "<=" | "**" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" | ">" | "<" }
callable_op = @{ overload_op ~ &"(" }

operator = @{
    ("!" ~ !"=")
  | (
        (
            ".>" | ".&" | ".?" | ".|"
          | "==" | "!=" | ">=" | "<="
          | "&&" | "||"
          | "**" | "<<" | ">>"
          | "+"  | "-"  | "*"  | "/" | "%"
          | ">"  | "<"
          | "&"  | "|"  | "."
        ) ~ &(" " | "\t" | "\r" | NEWLINE | EOI)
    )
}

// 7. Слитные пути, вызовы и идентификаторы (поддержка цепочек A.B().C().D):
PATH_END      = _{ &(" " | "\t" | "\r" | NEWLINE | "," | ")" | "]" | "}" | EOI) }
callable_path = @{ path_core ~ ("()" ~ ("." ~ (ident | index_seg))+)* ~ !("()" ~ ".") ~ &"(" }
path          = @{ path_core ~ ("()" ~ ("." ~ (ident | index_seg))+)* ~ PATH_END }
// ВАЖНО: path_core атомарный `@`, чтобы внутри `range_expr` (например, `1..Limit` или `1..Config.Max`)
// он возвращался как единый токен `Rule::path_core`!
path_core     = @{ ident ~ ("." ~ (ident | index_seg))* }
ident         = _{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
index_seg     = _{ "-"? ~ ASCII_DIGIT+ }