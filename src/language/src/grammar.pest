// =============================================================================
// RAZOMY LANGUAGE V5.7 — COMPLETE PRODUCTION PEST GRAMMAR
// =============================================================================

Program = { SOI ~ statements ~ EOI }

// --- ПРОБЕЛЫ И КОММЕНТАРИИ ---
WHITESPACE = _{ " " | "\t" | "\r" }

COMMENT = _{ line_comment | block_comment }
line_comment  = @{ "//" ~ (!NEWLINE ~ ANY)* }
// '#' открывает блочный комментарий ТОЛЬКО если за ним идет пробел или перевод строки.
// Внутри разрешены закавыченные '#' ("'#'" и "\"#\"").
block_comment = @{ "#" ~ &(" " | "\t" | "\r" | NEWLINE) ~ ( "'#'" | "\"#\"" | (!"#" ~ ANY) )* ~ "#" }

// --- РАЗДЕЛИТЕЛИ И МНОГОСТРОЧНЫЕ ПАЙПЛАЙНЫ / КОМПОЗИЦИИ ---
// ВАЖНО: `@` (atomic) гарантирует, что Pest не съест пробелы после "." или "&" неявным WHITESPACE*
PIPE_OP_AHEAD = @{
    ".>" | ".&" | ".?" | ".|"
  | (("." | "&") ~ (" " | "\t" | "\r" | NEWLINE))
}

// Перевод строки продолжает текущее предложение, если первое, что идет после
// любых пустых строк, отступов и комментариев — это оператор пайплайна или композиции `&`.
pipe_nl = _{ (NEWLINE ~ (WHITESPACE | COMMENT)*)+ ~ &PIPE_OP_AHEAD }

// Разделитель предложений срабатывает только тогда, когда это НЕ продолжение пайплайна
SEP = _{ "," | (!pipe_nl ~ NEWLINE) }

statements = _{ ( "," | NEWLINE )* ~ (sentence ~ (SEP+ ~ sentence)*)? ~ ( "," | NEWLINE )* }

// ВАЖНО: callable_op (`+ (other Vec2)` или `+(other Vec2)`) разрешен ТОЛЬКО в начале предложения (head_token)!
// В середине предложения бинарный оператор перед `(` обязан иметь пробел: `a + (b)`.
sentence   = { head_token ~ (pipe_nl? ~ tail_token)* }

// =============================================================================
// ТОКЕНЫ (СТРОГИК ПОРЯДОК ДЛЯ O(1) ЛЕКСИНГА)
// =============================================================================
head_token = _{
    group
  | range_expr
  | raw_string_lit
  | tagged_string_lit
  | string_lit
  | symbol_lit
  | hex_byte_lit
  | number_lit
  | callable_op
  | operator
  | callable_path
  | path
}

tail_token = _{
    group
  | range_expr
  | raw_string_lit
  | tagged_string_lit
  | string_lit
  | symbol_lit
  | hex_byte_lit
  | number_lit
  | operator
  | callable_path
  | path
}

// 1. Три гомоиконные скобки: {} (Form), [] (Stream), () (Tuple)
group = _{ brace_group | bracket_group | paren_group }
brace_group   = { "{" ~ statements ~ "}" }
bracket_group = { "[" ~ statements ~ "]" }
paren_group   = { "(" ~ statements ~ ")" }

// 2. Строки:
// - Raw Strings: r"...", r1"..."1, r2"..."2, r3"..."3 (без экранирования и без интерполяции)
// - Tagged Strings: Type"..." (100% синтаксический сахар для конструктора Type("..."))
// - Standard Strings: "..." (многострочные по умолчанию, с интерполяцией {expr} и \ экранированием)
// - Paired Symbols: '...'
raw_string_lit = @{
    ("r3\"" ~ (!"\"3" ~ ANY)* ~ "\"3")
  | ("r2\"" ~ (!"\"2" ~ ANY)* ~ "\"2")
  | ("r1\"" ~ (!"\"1" ~ ANY)* ~ "\"1")
  | ("r\""  ~ (!"\""  ~ ANY)* ~ "\"")
}

type_ident        = @{ ASCII_ALPHA_UPPER ~ (ASCII_ALPHANUMERIC | "_")* }
tagged_string_lit = ${ type_ident ~ (raw_string_lit | string_lit) }

string_lit = @{ "\"" ~ ( "\\\"" | "\\\\" | "\\{" | "\\}" | (!"\"" ~ ANY) )* ~ "\"" }
symbol_lit = @{ "'" ~ ( "\\'" | "\\\\" | (!"'" ~ ANY) )* ~ "'" }

// 3. Диапазоны (Ranges): 1..10, 1..limit, 1..Config.max, "0".."9", "a".."z"
range_atom = _{ string_lit | symbol_lit | number_lit | path_core }
range_expr = ${ range_atom ~ ".." ~ range_atom }

// 4. Байтовые и Числовые литералы (Byte, Int, Float)
hex_byte_lit = @{ "0x" ~ ASCII_HEX_DIGIT+ ~ !(ASCII_ALPHANUMERIC | "_") }

// ВАЖНО: ("." ~ !(ASCII_ALPHA | "_" | ".")) запрещает одиночную точку после числа (`1.2.3`),
// но разрешает диапазон `1..100` и слитную цепочку методов `(expr).to_float` / `0.0.to_float`!
number_lit = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ !(ASCII_ALPHA | "_" | ("." ~ !(ASCII_ALPHA | "_" | "."))) }

// 5. Операторы:
// - `callable_op`: перегрузка оператора `+ (other Vec2)`, `< (other Other) Bool`
//   (в начале sentence внутри Form `{}` с пробелом или слитно перед `(`)
// - `operator`: бинарные операторы (отделяются пробелом) и унарный `!` (примыкает плотно)
overload_op = _{ "==" | "!=" | ">=" | "<=" | "**" | "<<" | ">>" | "+" | "-" | "*" | "/" | "%" | ">" | "<" }
callable_op = @{ overload_op ~ &((" " | "\t")* ~ "(") }

operator = @{
    ("!" ~ !"=")
  | (
        (
            ".>" | ".&" | ".?" | ".|"
          | "==" | "!=" | ">=" | "<="
          | "&&" | "||"
          | "**" | "<<" | ">>"
          | "+"  | "-"  | "*"  | "/" | "%"
          | ">"  | "<"
          | "&"  | "|"  | "."
        ) ~ &(" " | "\t" | "\r" | NEWLINE | EOI)
    )
}

// 6. Слитные пути, вызовы и идентификаторы:
// Поддержка цепочек `a.b().c().d`, а также продолжения пути после закрывающей скобки `(self.scaled.to_float * factor).round_to_int`!
PATH_END      = _{ &(" " | "\t" | "\r" | NEWLINE | "," | ")" | "]" | "}" | EOI) }
callable_path = @{ ("."? ~ path_core) ~ ("()" ~ ("." ~ (ident | index_seg))+)* ~ !("()" ~ ".") ~ &"(" }
path          = @{ ("."? ~ path_core) ~ ("()" ~ ("." ~ (ident | index_seg))+)* ~ PATH_END }
// ВАЖНО: path_core атомарный `@`, чтобы внутри `range_expr` (например, `1..limit` или `1..Config.max`)
// он возвращался как единый токен `Rule::path_core`!
path_core     = @{ ident ~ ("." ~ (ident | index_seg))* }
ident         = _{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
index_seg     = _{ "-"? ~ ASCII_DIGIT+ }