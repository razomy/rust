// ============================================================================
// Razomy Notation (.rn) v0.1.0 — Layer 0 Universal Node Pest Grammar
// Node ::= Key ({Props})? ((Slots))? (Algebra)* (Schema)? ( " " Payload )?
// ============================================================================

WHITESPACE = _{ " " | "\t" }

document_line = { SOI ~ (comment_line | unified_node)? ~ EOI }
comment_line  = @{ "#" ~ ((" " | "\t") ~ ANY* | EOI) }

unified_node = {
    key_token ~ attached_props? ~ attached_slots? ~ algebra_chain? ~ schema_portal? ~ payload?
}

attached_props = { "{" ~ form_pairs? ~ "}" }
attached_slots = { "(" ~ tuple_cells? ~ ")" }
algebra_chain  = { (algebra_op ~ key_token)+ }
algebra_op     = { "&" | "^" | "/" }
schema_portal  = @{ ASCII_ALPHA_UPPER ~ (ASCII_ALPHANUMERIC | "_")* }

payload = {
    block_opener
    | inline_form
    | inline_tuple
    | inline_stream
    | col0_opener
    | typed_literal
    | symbol_lit
    | quoted_lit
    | backtick_lit
    | scalar_rest
}

block_opener  = { "{" | "(" | "[" }
inline_form   = { "{" ~ form_pairs? ~ "}" }
inline_tuple  = { "(" ~ tuple_cells? ~ ")" }
inline_stream = ${ "[" ~ stream_items? ~ "]" }
col0_opener   = @{ (ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*)? ~ ASCII_DIGIT* ~ "\"" }

stream_items      = ${ (inline_child_node | backtick_lit | quoted_lit | stream_raw_text)+ }
inline_child_node = ${ inline_tag_key ~ attached_props? ~ attached_slots? ~ "[" ~ stream_items? ~ "]" }
inline_tag_key    = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "-")* }

form_pairs = { form_field ~ ("," ~ form_field)* ~ ","? }
form_field = { key_token ~ attached_props? ~ attached_slots? ~ algebra_chain? ~ schema_portal? ~ payload? }

tuple_cells = { cell_val ~ ("," ~ cell_val)* ~ ","? }
cell_val    = { payload? }

typed_literal   = @{ (ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")*) ~ quoted_lit }
symbol_lit      = @{ "'" ~ (ASCII_ALPHANUMERIC | "_" | "-" | ".")+ }
quoted_lit      = @{ "\"" ~ ("\\\"" | "\\\\" | (!"\"" ~ ANY))* ~ "\"" }
backtick_lit    = @{ "`" ~ (!"`" ~ ANY)* ~ "`" }
key_token       = @{ quoted_lit | symbol_lit | (!(" " | "\t" | "\r" | "\n" | "[" | "]" | "{" | "}" | "(" | ")" | "," | "\"") ~ ANY)+ }
stream_raw_text = @{ (!("[" | "]" | "`" | "\"") ~ ANY)+ }
scalar_rest     = @{ (!("\r" | "\n" | "," | "}" | ")" | "]") ~ ANY)+ }