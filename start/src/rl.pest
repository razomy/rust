// ============================================================================
// 1. ИГНОРИРУЕМЫЕ СИМВОЛЫ
// ============================================================================
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ ("##" ~ (!"##" ~ ANY)* ~ "##") | ("#" ~ (!"\n" ~ ANY)*) }

// ============================================================================
// 2. КЛЮЧЕВЫЕ СЛОВА
// ============================================================================
K_IMPORT   = @{ "import" ~ !(ASCII_ALPHANUMERIC | "_") }
K_LET      = @{ "let" ~ !(ASCII_ALPHANUMERIC | "_") }
K_MUT      = @{ "mut" ~ !(ASCII_ALPHANUMERIC | "_") }
K_FN       = @{ "fn" ~ !(ASCII_ALPHANUMERIC | "_") }
K_OUT      = @{ "out" ~ !(ASCII_ALPHANUMERIC | "_") }
K_TYPE     = @{ "type" ~ !(ASCII_ALPHANUMERIC | "_") }
K_MATCH    = @{ "match" ~ !(ASCII_ALPHANUMERIC | "_") }
K_IF       = @{ "if" ~ !(ASCII_ALPHANUMERIC | "_") }
K_ELSE     = @{ "else" ~ !(ASCII_ALPHANUMERIC | "_") }
K_FOR      = @{ "for" ~ !(ASCII_ALPHANUMERIC | "_") }
K_IN       = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
K_WHILE    = @{ "while" ~ !(ASCII_ALPHANUMERIC | "_") }
K_RETURN   = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
K_BREAK    = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
K_CONTINUE = @{ "continue" ~ !(ASCII_ALPHANUMERIC | "_") }
K_NONE     = @{ "none" ~ !(ASCII_ALPHANUMERIC | "_") }
K_SOME     = @{ "Some" ~ !(ASCII_ALPHANUMERIC | "_") }
K_OK       = @{ "Ok" ~ !(ASCII_ALPHANUMERIC | "_") }
K_ERR      = @{ "Err" ~ !(ASCII_ALPHANUMERIC | "_") }
K_TRUE     = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
K_FALSE    = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }

RESERVED = _{
    K_IMPORT
  | K_LET
  | K_MUT
  | K_FN
  | K_OUT
  | K_TYPE
  | K_MATCH
  | K_IF
  | K_ELSE
  | K_FOR
  | K_IN
  | K_WHILE
  | K_RETURN
  | K_BREAK
  | K_CONTINUE
  | K_NONE
  | K_SOME
  | K_OK
  | K_ERR
  | K_TRUE
  | K_FALSE
}

// ============================================================================
// 3. БАЗОВЫЕ ТОКЕНЫ
// ============================================================================
IDENT         = @{ !RESERVED ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
NUMBER        = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
STRING        = ${ "\"" ~ (StrChar | Interpolation)* ~ "\"" }
StrChar       = _{ (!("\"" | "${" | "\\") ~ ANY) | ("\\" ~ ANY) }
Interpolation = !{ "${" ~ Expr ~ "}" }

// ============================================================================
// 4. СИСТЕМА ТИПОВ
// ============================================================================
Type       = { IDENT ~ TypeArgs? ~ OptionType? }
TypeArgs   = { "(" ~ Type ~ ("," ~ Type)* ~ ","? ~ ")" }
OptionType = { "?" }

GenericParam = { IDENT ~ (":"? ~ Type)? }
FnGenerics   = { "(" ~ (GenericParam ~ ("," ~ GenericParam)*)? ~ ","? ~ ")" }

ExplicitTypeArgs = { "::" ~ TypeArgs }

// ============================================================================
// 5. ВЫРАЖЕНИЯ (Expressions)
// ============================================================================
Expr = { IfExpr | MatchExpr | Closure | RangeExpr }

RangeExpr = { LogicOrExpr ~ (".." ~ LogicOrExpr)? }

LogicOrExpr  = { LogicAndExpr ~ (("||" | "or") ~ LogicAndExpr)* }
LogicAndExpr = { CmpExpr ~ (("&&" | "and") ~ CmpExpr)* }

CmpExpr  = { MathExpr ~ (("==" | "!=" | ">=" | "<=" | ">" | "<") ~ MathExpr)* }
MathExpr = { Term ~ (("+" | "-") ~ Term)* }
Term     = { Unary ~ (("*" | "/" | "%") ~ Unary)* }

Unary   = { UnaryOp* ~ Factor }
UnaryOp = { "-" | "!" | "not" }

Factor      =  { Primary ~ ExplicitTypeArgs? ~ Postfix* }
Postfix     = _{ MethodCall | FieldAccess | CallArgs | IndexAccess }
MethodCall  =  { "." ~ IDENT ~ ExplicitTypeArgs? ~ "(" ~ ArgList? ~ ")" }
FieldAccess =  { "." ~ IDENT }
IndexAccess =  { "[" ~ Expr ~ "]" }
CallArgs    =  { "(" ~ ArgList? ~ ")" }
ArgList     =  { Expr ~ ("," ~ Expr)* ~ ","? }

Primary = {
    ConstructorCall
  | Literal
  | StructInit
  | IDENT
  | "(" ~ Expr ~ ")"
}

ConstructorCall = { (K_SOME | K_OK | K_ERR) ~ "(" ~ ArgList? ~ ")" }

Literal   = { NUMBER | STRING | K_TRUE | K_FALSE | ArrayInit | K_NONE }
ArrayInit = { "[" ~ (Expr ~ ("," ~ Expr)*)? ~ ","? ~ "]" }

StructInit  = { "{" ~ (StructField ~ ("," ~ StructField)*)? ~ ","? ~ "}" }
StructField = { IDENT ~ (":"? ~ Expr) | ".." ~ Expr? }

Closure = { "(" ~ (IDENT ~ ("," ~ IDENT)*)? ~ ","? ~ ")" ~ "=" ~ Expr }

// ============================================================================
// 6. БЛОКИ И КОНТРОЛЬ ПОТОКА
// ============================================================================
Block = { "{" ~ Stmt* ~ Expr? ~ "}" }
Body  = { "="? ~ Block | "=" ~ Stmt+ }

IfExpr = { K_IF ~ Expr ~ Block ~ (K_ELSE ~ (IfExpr | Block))? }

MatchExpr = { K_MATCH ~ Expr ~ "{" ~ (MatchArm ~ ","?)* ~ "}" }
MatchArm  = { Pattern ~ (K_IF ~ Expr)? ~ "=" ~ (Block | Expr) }

Pattern        = {
    VariantPat
  | StructPat
  | Literal
  | "_"
  | IDENT
}
VariantPat     = { (K_SOME | K_OK | K_ERR | IDENT) ~ ("(" ~ (Pattern ~ ("," ~ Pattern)*)? ~ ","? ~ ")")? }
StructPat      = { "{" ~ (StructFieldPat ~ ("," ~ StructFieldPat)*)? ~ (","? ~ "..")? ~ "}" }
StructFieldPat = { IDENT ~ (":" ~ Pattern)? }

// ============================================================================
// 7. ИНСТРУКЦИИ (Statements)
// ============================================================================
Stmt = {
    LetStmt
  | AssignStmt
  | WhileStmt
  | ForStmt
  | FlowStmt
  | ExprStmt
}

LetStmt    = { K_LET ~ K_MUT? ~ IDENT ~ Type? ~ "=" ~ Expr ~ ";"? }
AssignOp   = { "=" | "+=" | "-=" | "*=" | "/=" | "%=" }
AssignStmt = { (IDENT ~ Postfix*) ~ AssignOp ~ Expr ~ ";"? }
WhileStmt  = { K_WHILE ~ Expr ~ Block }
ForStmt    = { K_FOR ~ IDENT ~ K_IN ~ Expr ~ Block }

FlowStmt     = { (ReturnStmt | BreakStmt | ContinueStmt) ~ ";"? }
ReturnStmt   = { K_RETURN ~ Expr? }
BreakStmt    = { K_BREAK }
ContinueStmt = { K_CONTINUE }

ExprStmt = { Expr ~ ";"? }

// ============================================================================
// 8. ДЕКЛАРАЦИИ ВЕРХНЕГО УРОВНЯ
// ============================================================================
Program = { SOI ~ Decl* ~ EOI }
Decl    = { ImportDecl | TypeDecl | FnDecl }

ImportDecl = { K_IMPORT ~ ImportPath }
ImportPath = { IDENT ~ ("::" ~ (ImportList | "*" | IDENT))* }
ImportList = { "{" ~ IDENT ~ ("," ~ IDENT)* ~ ","? ~ "}" }

TypeDecl         = { K_TYPE ~ IDENT ~ TypeDeclGenerics? ~ (UnionDef | RecordDef)? }
TypeDeclGenerics = { "(" ~ (GenericParam ~ ("," ~ GenericParam)*)? ~ ","? ~ ")" }

RecordDef = { "{" ~ (FieldDef ~ ("," ~ FieldDef)*)? ~ ","? ~ "}" | (FieldDef ~ ("," ~ FieldDef)*) }
FieldDef  = { IDENT ~ ":"? ~ Type }

UnionDef        = { "=" ~ "|"? ~ VariantDef ~ ("|" ~ VariantDef)* }
VariantDef      = { IDENT ~ ("(" ~ (VariantFieldDef ~ ("," ~ VariantFieldDef)*)? ~ ","? ~ ")")? }
VariantFieldDef = { IDENT ~ ":"? ~ Type | Type }

FnDecl      = { K_OUT? ~ K_FN ~ IDENT ~ (FnGenerics ~ FnArgsGroup | FnArgs)? ~ ReturnType? ~ Body }
FnArgsGroup = { "(" ~ (ArgDef ~ ("," ~ ArgDef)*)? ~ ","? ~ ")" }
FnArgs      = { FnArgsGroup | ArgDef }
ArgDef      = { IDENT ~ Type? ~ ("=" ~ Expr)? }
ReturnType  = { ("Return" ~ "(" ~ Type ~ ")") | Type }