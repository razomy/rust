// --- 1. ИГНОРИРУЕМЫЕ СИМВОЛЫ ---
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ ("#" ~ (!"\n" ~ ANY)*) | ("##" ~ (!"##" ~ ANY)* ~ "##") }

// --- 2. КЛЮЧЕВЫЕ СЛОВА ---
K_LET   = _{ "let" ~ !ASCII_ALPHANUMERIC }
K_MUT   = _{ "mut" ~ !ASCII_ALPHANUMERIC }
K_FN    = _{ "fn" ~ !ASCII_ALPHANUMERIC }
K_OUT   = _{ "out" ~ !ASCII_ALPHANUMERIC }
K_TYPE  = _{ "type" ~ !ASCII_ALPHANUMERIC }
K_MATCH = _{ "match" ~ !ASCII_ALPHANUMERIC }
K_IF    = _{ "if" ~ !ASCII_ALPHANUMERIC }
K_ELSE  = _{ "else" ~ !ASCII_ALPHANUMERIC }
K_FOR   = _{ "for" ~ !ASCII_ALPHANUMERIC }
K_IN    = _{ "in" ~ !ASCII_ALPHANUMERIC }
K_WHILE = _{ "while" ~ !ASCII_ALPHANUMERIC }
K_NONE  =  { "none" ~ !ASCII_ALPHANUMERIC }
K_SOME  =  { "Some" ~ !ASCII_ALPHANUMERIC }
K_OK    =  { "Ok" ~ !ASCII_ALPHANUMERIC }
K_ERR   =  { "Err" ~ !ASCII_ALPHANUMERIC }

RESERVED = _{ K_LET | K_MUT | K_FN | K_OUT | K_TYPE | K_MATCH | K_IF | K_ELSE | K_FOR | K_IN | K_WHILE | K_NONE | K_SOME | K_OK | K_ERR }

// --- 3. БАЗОВЫЕ ТОКЕНЫ ---
IDENT   = @{ !RESERVED ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
NUMBER  = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
STRING  = ${ "\"" ~ (StrChar | Interpolation)* ~ "\"" }
StrChar = _{ !("\"" | "${") ~ ANY }
Interpolation = !{ "${" ~ Expr ~ "}" }

// --- 4. СИСТЕМА ТИПОВ ---
Type        = { IDENT ~ TypeGen? ~ OptionType? }
TypeGen     = { "(" ~ Type ~ (","? ~ Type)* ~ ")" }
OptionType  = { "?" }
FnTypeGen   = { "(" ~ IDENT ~ Type ~ ")" }

// --- 5. ВЫРАЖЕНИЯ (Expressions) ---
Expr        = { IfExpr | MatchExpr | Closure | Pipeline }

// Пайплайны (.map)
Pipeline    = { RangeExpr ~ ("." ~ CallExpr)* }
// Вызовы функций (print("hi") или map((x) = x))
CallExpr    = { IDENT ~ "(" ~ (Expr ~ (","? ~ Expr)*)? ~ ")" }

RangeExpr   = { LogicExpr ~ (".." ~ LogicExpr)? }
LogicExpr   = { MathExpr ~ (("==" | "!=" | ">" | "<" | ">=" | "<=") ~ MathExpr)* }
MathExpr    = { Term ~ (("+" | "-") ~ Term)* }
Term        = { Factor ~ (("*" | "/") ~ Factor)* }

// Базовые элементы
Factor      = { Literal | StructInit | CallExpr | IDENT | "(" ~ Expr ~ ")" }
Literal     = { NUMBER | STRING | ArrayInit | K_NONE }
ArrayInit   = { "[" ~ Expr ~ (","? ~ Expr)* ~ "]" }

StructInit  = { "{" ~ (StructField ~ ","?)* ~ "}" }
StructField = { IDENT ~ Expr | ".." }

// --- 6. БЛОКИ И КОНТРОЛЬ ПОТОКА ---
// Блок: либо в { }, либо просто набор инструкций (для Python-стиля)
Block       = { "{" ~ Stmt* ~ Expr? ~ "}" | Stmt+ }
Body        = { "="? ~ Block }

IfExpr      = { K_IF ~ Expr ~ Block ~ (K_ELSE ~ Block)? }

MatchExpr   = { K_MATCH ~ Expr ~ "{"? ~ MatchArm* ~ "}"? }
MatchArm    = { Pattern ~ (K_IF ~ Expr)? ~ "=" ~ Block }
Pattern     = { StructPat | VariantPat | K_NONE | "_" | IDENT }
StructPat   = { "{" ~ (IDENT ~ (","? ~ IDENT)* ~ (","? ~ "..")?)? ~ "}" }
VariantPat  = { IDENT ~ ("(" ~ IDENT ~ ")")? }

Closure     = { "(" ~ (IDENT ~ (","? ~ IDENT)*)? ~ ")" ~ "=" ~ Expr }

// --- 7. ИНСТРУКЦИИ (Statements) ---
// ВАЖНО: Порядок имеет значение. Сначала присваивание, потом выражения.
Stmt        = { LetStmt | AssignStmt | WhileStmt | ForStmt | ExprStmt }

LetStmt     = { K_LET ~ K_MUT? ~ IDENT ~ Type? ~ "=" ~ Expr }
AssignStmt  = { IDENT ~ "=" ~ Expr }
WhileStmt   = { K_WHILE ~ Expr ~ Block }
ForStmt     = { K_FOR ~ IDENT ~ K_IN ~ Expr ~ Block }
ExprStmt    = { Expr }

// --- 8. ДЕКЛАРАЦИИ ВЕРХНЕГО УРОВНЯ ---
Program     = { SOI ~ Decl* ~ EOI }
Decl        = { ImportDecl | TypeDecl | FnDecl }

ImportDecl  = { "import" ~ IDENT }

// Объявления структур (запятые и скобки опциональны!)
TypeDecl    = { K_TYPE ~ IDENT ~ TypeGen? ~ (RecordDef | UnionDef)? }
RecordDef   = { "{" ~ (FieldDef ~ ","?)* ~ "}" | (FieldDef ~ ","?)+ }
FieldDef    = { IDENT ~ Type }

UnionDef    = { "="? ~ ("|" ~ VariantDef)+ }
VariantDef  = { IDENT ~ ("(" ~ Type ~ ")")? }

// Функции (аргументы либо в (), либо без если это 1 аргумент)
FnDecl      = { K_OUT? ~ K_FN ~ IDENT ~ FnTypeGen? ~ FnArgs ~ ReturnType? ~ Body }
FnArgs      = { "(" ~ (ArgDef ~ ","?)* ~ ")" | IDENT | "" }
ArgDef      = { IDENT ~ Type ~ ("=" ~ Expr)? }
ReturnType  = { Type | ("Return" ~ "(" ~ IDENT ~ ")") }