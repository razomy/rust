// === ОСНОВНАЯ СТРУКТУРА ===
program    = { SOI ~ STATEMENTS ~ EOI }
STATEMENTS = _{ SEP* ~ (sentence ~ (SEP+ ~ sentence)*)? ~ SEP* }
sentence   = { token+ }

token = _{
    group
  | literal
}

// === РАЗДЕЛИТЕЛИ ===
SEP = _{ NEWLINE | SEMICOLON | COLON }


// === ГРУППЫ ===
group = {
  brace_group
  | bracket_group
  | paren_group
  | angle_group
}

brace_group       = { BRACE_OPEN ~ STATEMENTS ~ BRACE_CLOSE }
bracket_group     = { BRACKET_OPEN ~ STATEMENTS ~ BRACKET_CLOSE }
paren_group       = { PAREN_OPEN ~ STATEMENTS ~ PAREN_CLOSE }
angle_group       = { ANGLE_OPEN ~ STATEMENTS ~ ANGLE_CLOSE }


// === ЛИТЕРАЛЫ И ТОКЕНЫ ===
literal = {
    number
  | word
  | single_quote_group
  | double_quote_group
  | backtick_quote_group
  | op
}

number = @{ DIGIT ~ (DOT ~ DIGIT)? }
// Слово начинается с буквы/_, дальше могут идти буквы/_ и цифры
word   = @{ WORD_START ~ WORD_PART* }

// Правильное экранирование: (Слеш + любой символ) или (Любой символ)
single_quote_group   = @{ SINGLE_QUOTE ~ (!SINGLE_QUOTE ~ (BACKSLASH ~ ANY | ANY))* ~ SINGLE_QUOTE }
double_quote_group   = @{ DOUBLE_QUOTE ~ (!DOUBLE_QUOTE ~ (BACKSLASH ~ ANY | ANY))* ~ DOUBLE_QUOTE }
backtick_quote_group = @{ BACKTICK ~ (!BACKTICK ~ (BACKSLASH ~ ANY | ANY))* ~ BACKTICK }
comment_group     = { DOUBLE_HASH ~ (!DOUBLE_HASH ~ ANY)* ~ DOUBLE_HASH }

op = @{ (!OPERATOR_GROUP ~ !SEP ~ !WHITESPACE ~ (PUNCTUATION | SYMBOL))+ }

// === ИМЕНОВАННЫЕ СОСТАВНЫЕ СИМВОЛЫ ===
DOUBLE_HASH = _{ HASH ~ HASH }
DIGIT       = _{ ASCII_DIGIT+ }
WORD_START  = _{ ASCII_ALPHA | UNDERSCORE }
WORD_PART   = _{ ASCII_ALPHANUMERIC | UNDERSCORE }

OPERATOR_GROUP = _{
    PAREN_OPEN
  | PAREN_CLOSE
  | BRACKET_OPEN
  | BRACKET_CLOSE
  | BRACE_OPEN
  | BRACE_CLOSE
  | ANGLE_OPEN
  | ANGLE_CLOSE
  | DOUBLE_HASH
  | SINGLE_QUOTE
  | DOUBLE_QUOTE
  | BACKTICK
}

// === ИМЕНОВАННЫЕ КОНСТАНТЫ СИМВОЛОВ ===
// Split / Whitespace
SPACE      = _{ " " }
WHITESPACE = _{ SPACE | "\t" }
DOT        = _{ "." }
COMMA      = _{ "," }
COLON      = _{ ":" }
SEMICOLON  = _{ ";" }
EQUALS     = _{ "=" }
PIPE       = _{ "|" }
PERCENT    = _{ "%" }

// Join / Word characters
DASH       = _{ "-" }
UNDERSCORE = _{ "_" }
PLUS       = _{ "+" }
CARET      = _{ "^" }
TILDE      = _{ "~" }
ASTERISK   = _{ "*" }
AMPERSAND  = _{ "&" }
AT_SIGN    = _{ "@" }

// Delimiters & Groups
DOUBLE_QUOTE = _{ "\"" }
SINGLE_QUOTE = _{ "'" }
BACKTICK     = _{ "`" }

ANGLE_OPEN   = _{ "<" }
ANGLE_CLOSE  = _{ ">" }
PAREN_OPEN   = _{ "(" }
PAREN_CLOSE  = _{ ")" }
BRACKET_OPEN = _{ "[" }
BRACKET_CLOSE= _{ "]" }
BRACE_OPEN   = _{ "{" }
BRACE_CLOSE  = _{ "}" }

// Slashes
SLASH     = _{ "/" }
BACKSLASH = _{ "\\" }

// Priority & Misc
EXCLAMATION = _{ "!" }
QUESTION    = _{ "?" }
HASH        = _{ "#" }
DOLLAR      = _{ "$" }