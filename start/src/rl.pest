// ============================================================================
// 1. ИГНОРИРУЕМЫЕ СИМВОЛЫ
// ============================================================================
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ ("##" ~ (!"##" ~ ANY)* ~ "##") | ("#" ~ !"#" ~ (!"\n" ~ ANY)*) }

// ============================================================================
// 2. КЛЮЧЕВЫЕ СЛОВА
// ============================================================================
K_IM       = @{ "im" ~ !(ASCII_ALPHANUMERIC | "_") }
K_VR       = @{ "vr" ~ !(ASCII_ALPHANUMERIC | "_") }
K_MUT      = @{ "mut" ~ !(ASCII_ALPHANUMERIC | "_") }
K_FN       = @{ "fn" ~ !(ASCII_ALPHANUMERIC | "_") }
K_OUT      = @{ "out" ~ !(ASCII_ALPHANUMERIC | "_") }
K_TYPE     = @{ "type" ~ !(ASCII_ALPHANUMERIC | "_") }
K_MATCH    = @{ "match" ~ !(ASCII_ALPHANUMERIC | "_") }
K_IF       = @{ "if" ~ !(ASCII_ALPHANUMERIC | "_") }
K_ELSE     = @{ "else" ~ !(ASCII_ALPHANUMERIC | "_") }
K_FOR      = @{ "for" ~ !(ASCII_ALPHANUMERIC | "_") }
K_IN       = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
K_WHILE    = @{ "while" ~ !(ASCII_ALPHANUMERIC | "_") }
K_RETURN   = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
K_BREAK    = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
K_CONTINUE = @{ "continue" ~ !(ASCII_ALPHANUMERIC | "_") }
K_NONE     = @{ "none" ~ !(ASCII_ALPHANUMERIC | "_") }
K_SOME     = @{ "Some" ~ !(ASCII_ALPHANUMERIC | "_") }
K_OK       = @{ "Ok" ~ !(ASCII_ALPHANUMERIC | "_") }
K_ERR      = @{ "Err" ~ !(ASCII_ALPHANUMERIC | "_") }
K_TRUE     = @{ "true" ~ !(ASCII_ALPHANUMERIC | "_") }
K_FALSE    = @{ "false" ~ !(ASCII_ALPHANUMERIC | "_") }

RESERVED = _{
    K_IM | K_VR | K_MUT | K_FN | K_OUT | K_TYPE | K_MATCH
  | K_IF | K_ELSE | K_FOR | K_IN | K_WHILE | K_RETURN
  | K_BREAK | K_CONTINUE | K_NONE | K_SOME | K_OK | K_ERR
  | K_TRUE | K_FALSE
}

// ============================================================================
// 3. БАЗОВЫЕ ТОКЕНЫ
// ============================================================================
IDENT         = @{ !RESERVED ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
NUMBER        = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

// Исправлено: StrText собирает статические части строки между интерполяциями
STRING        = ${ "\"" ~ (StrText | Interpolation)* ~ "\"" }
StrText       = @{ StrChar+ }
StrChar       = _{ (!("\"" | "${" | "\\") ~ ANY) | ("\\" ~ ANY) }
Interpolation = !{ "${" ~ Expr ~ "}" }

// ============================================================================
// 4. СИСТЕМА ТИПОВ
// ============================================================================
Type = { (FuncType | ArrayType | BaseType) ~ OptionType? }

BaseType   = { IDENT ~ TypeArgs? }
ArrayType  = { "[" ~ Type ~ "]" }
FuncType   = { "(" ~ (Type ~ ("," ~ Type)*)? ~ ")" ~ "->" ~ Type }
TypeArgs   = { "(" ~ Type ~ ("," ~ Type)* ~ ","? ~ ")" }
OptionType = { "?" }

// Ограничения и мета-дженерики: <T>, <T Number>, <TT Real = Number>
GenericConstraint = { IDENT ~ Type? ~ ("=" ~ Type)? }
MetaGenerics      = { "<" ~ GenericConstraint ~ ("," ~ GenericConstraint)* ~ ","? ~ ">" }

// Параметры типа: Container(T), Buffer(Size Int = 1024)
TypeParamDef = { IDENT ~ Type? ~ ("=" ~ (Literal | Type))? }
TypeParams   = { "(" ~ TypeParamDef ~ ("," ~ TypeParamDef)* ~ ","? ~ ")" }

// ============================================================================
// 5. ВЫРАЖЕНИЯ (Expressions)
// ============================================================================
Expr = { IfExpr | MatchExpr | Closure | FlowExpr | RangeExpr }

// Flow control в качестве выражений
FlowExpr     = { ReturnExpr | BreakExpr | ContinueExpr }
ReturnExpr   = { K_RETURN ~ Expr? }
BreakExpr    = { K_BREAK }
ContinueExpr = { K_CONTINUE }

// Лямбды: (x) = x * 2, x = x * 2
Closure          = { (ClosureParamList | IDENT) ~ "=" ~ (Block | Expr) }
ClosureParamList = { "(" ~ (IDENT ~ ("," ~ IDENT)*)? ~ ","? ~ ")" }

// Операторы выражений (сохраняются в AST)
RangeOp    = { "..=" | ".." }
CoalesceOp = { "??" }
LogicOrOp  = { "||" | "or" }
LogicAndOp = { "&&" | "and" }
BitOrOp    = { "|" }
BitXorOp   = { "^" }
BitAndOp   = { "&" }
CmpOp      = { "==" | "!=" | ">=" | "<=" | ">" | "<" }
AddOp      = { "+" | "-" }
MulOp      = { "*" | "/" | "%" }

// Диапазоны: 1..5, 1..=5
RangeExpr = { CoalesceExpr ~ (RangeOp ~ CoalesceExpr)? }

// Null-coalescing: a ?? b
CoalesceExpr = { LogicOrExpr ~ (CoalesceOp ~ LogicOrExpr)* }

LogicOrExpr  = { LogicAndExpr ~ (LogicOrOp ~ LogicAndExpr)* }
LogicAndExpr = { BitOrExpr ~ (LogicAndOp ~ BitOrExpr)* }

// Побитовые операции: |, ^, &
BitOrExpr  = { BitXorExpr ~ (BitOrOp ~ BitXorExpr)* }
BitXorExpr = { BitAndExpr ~ (BitXorOp ~ BitAndExpr)* }
BitAndExpr = { CmpExpr ~ (BitAndOp ~ CmpExpr)* }

CmpExpr  = { MathExpr ~ (CmpOp ~ MathExpr)* }
MathExpr = { Term ~ (AddOp ~ Term)* }
Term     = { Unary ~ (MulOp ~ Unary)* }

Unary   = { UnaryOp* ~ Factor }
UnaryOp = { "-" | "!" | "not" }

Factor         =  { Primary ~ Postfix* }
Postfix        = _{ OptChainMethod | OptChainField | MethodCall | FieldAccess | CallArgs | IndexAccess | TryOp }
TryOp          =  { "?" }
OptChainMethod =  { "?." ~ IDENT ~ "(" ~ ArgList? ~ ")" }
OptChainField  =  { "?." ~ IDENT }
MethodCall     =  { "." ~ IDENT ~ "(" ~ ArgList? ~ ")" }
FieldAccess    =  { "." ~ IDENT }
IndexAccess    =  { "[" ~ Expr ~ "]" }
CallArgs       =  { "(" ~ ArgList? ~ ")" }
ArgList        =  { Expr ~ ("," ~ Expr)* ~ ","? }

Primary = {
    ConstructorCall
  | TupleExpr
  | Literal
  | StructInit
  | IDENT
  | "(" ~ Expr ~ ")"
}

TupleExpr       = { "(" ~ Expr ~ ("," ~ Expr)+ ~ ","? ~ ")" }
ConstructorCall = { (K_SOME | K_OK | K_ERR) ~ "(" ~ ArgList? ~ ")" }

Literal   = { NUMBER | STRING | K_TRUE | K_FALSE | ArrayInit | K_NONE }
ArrayInit = { "[" ~ (Expr ~ ("," ~ Expr)*)? ~ ","? ~ "]" }

Spread      = { ".." ~ Expr? }
StructInit  = { "{" ~ (StructField ~ ("," ~ StructField)*)? ~ ","? ~ "}" }
StructField = { Spread | IDENT ~ ":"? ~ Expr }

// ============================================================================
// 6. БЛОКИ И КОНТРОЛЬ ПОТОКА
// ============================================================================
Block = { "{" ~ (FnDecl | Stmt)* ~ Expr? ~ "}" }

// if: блочный или инлайн (в инлайн else обязателен)
IfExpr = {
    (K_IF ~ Expr ~ Block ~ (K_ELSE ~ (IfExpr | Block))?)
  | (K_IF ~ InlineCond ~ (Block | Expr) ~ K_ELSE ~ (Block | Expr))
}

// Исправлено: InlineCond и InlineCmp не скрыты (_), содержат явные CmpOp и LogicOp
InlineCond = { InlineCmp ~ ((LogicAndOp | LogicOrOp) ~ InlineCmp)* }
InlineCmp  = { MathExpr ~ (CmpOp ~ Unary)? }

MatchExpr = { K_MATCH ~ Expr ~ "{" ~ (MatchArm ~ ","?)+ ~ "}" }
MatchArm  = { Pattern ~ (K_IF ~ Expr)? ~ "=" ~ (Block | Expr) }

// Паттерны сопоставления
WildcardPat = { "_" }
RestPat     = { ".." }

Pattern = {
    WildcardPat
  | TuplePat
  | StructPat
  | VariantPat
  | Literal
  | VarPat
}
TuplePat   = { "(" ~ Pattern ~ ("," ~ Pattern)+ ~ ","? ~ ")" }
VariantPat = { (K_SOME | K_OK | K_ERR | (K_NONE ~ "(") | IDENT) ~ ("(" ~ (Pattern ~ ("," ~ Pattern)*)? ~ ","? ~ ")")? }
VarPat     = { IDENT }
StructPat  = { "{" ~ (StructFieldPat ~ ("," ~ StructFieldPat)*)? ~ (","? ~ RestPat)? ~ ","? ~ "}" }
StructFieldPat = { IDENT ~ (":"? ~ Pattern)? }

// ============================================================================
// 7. ИНСТРУКЦИИ (Statements)
// ============================================================================
Stmt = {
    VrStmt
  | AssignStmt
  | WhileStmt
  | ForStmt
  | FlowStmt
  | ExprStmt
}

VrStmt     = { K_VR ~ K_MUT? ~ Pattern ~ Type? ~ "=" ~ Expr ~ ";"? }
AssignOp   = { "=" | "+=" | "-=" | "*=" | "/=" | "%=" }
AssignStmt = { (IDENT ~ Postfix*) ~ AssignOp ~ Expr ~ ";"? }
WhileStmt  = { K_WHILE ~ Expr ~ (Block | Stmt) }
ForStmt    = { K_FOR ~ Pattern ~ K_IN ~ Expr ~ (Block | Stmt) }

FlowStmt   = { FlowExpr ~ ";"? }
ExprStmt   = { Expr ~ ";"? }

// ============================================================================
// 8. ДЕКЛАРАЦИИ ВЕРХНЕГО УРОВНЯ
// ============================================================================
Program = { SOI ~ Item* ~ EOI }
Item    = { ImportDecl | TypeDecl | FnDecl | Stmt }

// im std.io | im _core = "core" | im { log, warn } = "std/logger"
ImportPath   = { STRING }
ImportDecl   = { K_IM ~ ImportTarget ~ ("=" ~ ImportPath)? }
ImportTarget = { ImportList | DottedIdent }
DottedIdent  = { IDENT ~ ("." ~ IDENT)* }
ImportList   = { "{" ~ IDENT ~ ("," ~ IDENT)* ~ ","? ~ "}" }

// type Declarations: records, unions, aliases
TypeDecl     = { K_TYPE ~ IDENT ~ MetaGenerics? ~ TypeParams? ~ (TypeAliasDef | UnionDef | RecordDef)? }
TypeAliasDef = { "=" ~ (RecordDef | Type) }
RecordDef    = { "{" ~ (FieldDef ~ ("," ~ FieldDef)*)? ~ ","? ~ "}" }
FieldDef     = { IDENT ~ ":"? ~ Type }

UnionDef        = { "=" ~ "|"? ~ VariantDef ~ ("|" ~ VariantDef)* }
VariantDef      = { VariantName ~ ("(" ~ (VariantFieldDef ~ ("," ~ VariantFieldDef)*)? ~ ","? ~ ")")? }
VariantName     = { K_SOME | K_NONE | IDENT }
VariantFieldDef = { RecordDef | (IDENT ~ Type) | Type }

// Функции
FnDecl     = { K_OUT? ~ K_FN ~ IDENT ~ MetaGenerics? ~ FnArgs? ~ FnBody }
FnArgs     = { "(" ~ (ArgDef ~ ("," ~ ArgDef)*)? ~ ","? ~ ")" }
ArgDef     = { IDENT ~ Type? ~ ("=" ~ Expr)? }
ReturnType = { Type }

FnBody = {
    (ReturnType ~ "=" ~ FnExprBody)
  | ("=" ~ FnExprBody)
  | (ReturnType? ~ Block)
  | Stmt+
}
FnExprBody = { Block | Expr }